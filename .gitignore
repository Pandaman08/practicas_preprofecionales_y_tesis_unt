# dependencies
node_modules/
/.pnp
.pnp.js

# testing
/coverage

# next.js (frontend)
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript general
*.tsbuildinfo
next-env.d.ts

