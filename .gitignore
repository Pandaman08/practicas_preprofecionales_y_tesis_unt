# BACKEND (NestJS)
# ========================
backend/dist/
backend/**/*.js
backend/**/*.d.ts
backend/**/*.js.map
!backend/**/*.spec.js  # Excepto archivos de prueba si los tienes
!backend/**/*.e2e.js

# ========================
# FRONTEND (Next.js)
# ========================
frontend/.next/
frontend/out/
frontend/build/

